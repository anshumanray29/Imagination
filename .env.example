# ─────────────────────────────────────────────────────────────
# IMG (Imagination) — configuration
# Copy this file to `.env` and fill in the keys you have.
# Anything left blank is simply disabled in the app.
# ─────────────────────────────────────────────────────────────

# Server (bound to localhost only — not reachable from other machines)
HOST=127.0.0.1
PORT=8787
# Where the SQLite database, local files and caches live
DATA_DIR=./data
# How many generations may run at the same time
MAX_CONCURRENT_JOBS=4

# ── Storage ──────────────────────────────────────────────────
# auto  = use R2 when all R2 values below are set, otherwise local disk
# local = always store files under DATA_DIR/storage
# r2    = always use Cloudflare R2 (startup fails if R2 is not configured)
STORAGE_DRIVER=auto

# Cloudflare R2 (Dashboard → R2 → Manage R2 API Tokens → "Object Read & Write")
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: put everything under a folder inside the bucket, e.g. "img/"
R2_PREFIX=

# ── Google Gemini (AI Studio → Get API key; video needs a paid-tier project) ──
GEMINI_API_KEY=
# Text model used for "Enhance prompt" and "Auto-describe character"
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# ── xAI Grok (console.x.ai → API Keys) ──
XAI_API_KEY=
XAI_TEXT_MODEL=grok-4.7

# ── Wan / Alibaba Cloud Model Studio (DashScope) ──
DASHSCOPE_API_KEY=
# The API key only works in the region it was created in.
#   Singapore (default):  https://dashscope-intl.aliyuncs.com/api/v1
#   Workspace host:       https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com/api/v1
#   US (Virginia):        https://{WorkspaceId}.us-east-1.maas.aliyuncs.com/api/v1
#   Beijing:              https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_VISION_MODEL=qwen-vl-max

# ── Mock provider (free, offline; generates placeholder media for testing) ──
ENABLE_MOCK_PROVIDER=true

# ffmpeg / ffprobe (leave blank to use the ones on PATH)
FFMPEG_PATH=
FFPROBE_PATH=

# ── Advanced (leave blank unless you need them) ──────────────
# Use any S3-compatible storage (e.g. MinIO) instead of Cloudflare R2
R2_ENDPOINT=
# Route API calls through a proxy/gateway
GEMINI_BASE_URL=
XAI_BASE_URL=
